{
  "name": "party-bet-arena",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emulators": "firebase emulators:start --project demo-party-bet-security --only auth,database",
    "build": "tsc -b && vite build --configLoader runner",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "test:rules:emulator": "firebase emulators:exec --project demo-party-bet-security --only database \"npm run test:rules\"",
    "test:e2e": "playwright test --project=local",
    "test:e2e:online": "firebase emulators:exec --project demo-party-bet-security --only auth,database \"playwright test --project=online\"",
    "check": "npm run typecheck && npm run lint && npm test && npm run build",
    "verify:qr": "node scripts/verify-qr-image.mjs"
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^0.555.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-qr-code": "^2.0.18"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.6",
    "websocket-driver": "^0.7.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.19.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.4.26",
    "firebase-tools": "^15.34.0",
    "globals": "^16.5.0",
    "jpeg-js": "^0.4.4",
    "jsdom": "^26.1.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.74.0",
    "vite": "^7.3.5",
    "vitest": "^5.1.1"
  },
  "description": "Odds, bets and live standings for game nights. React, TypeScript and Firebase Realtime Database.",
  "engines": {
    "node": ">=22"
  }
}
